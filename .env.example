# Copier ce fichier en .env.local et renseigner les vraies valeurs.

# SMTP — envoi des e-mails du formulaire de contact (étape 2).
# Tant que ces variables ne sont pas définies, les messages sont
# simplement journalisés dans la console serveur (voir src/lib/mail.ts).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_TO_EMAIL=contact@tnmarine.dz

# Base de données Postgres (ex. Neon : https://neon.tech, palier gratuit).
# Utiliser la chaîne de connexion "pooled" fournie par Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js — générer une valeur avec `openssl rand -base64 32`
AUTH_SECRET=

# Chatbot IA — API Claude (Anthropic). Sans clé, le widget répond avec un
# message invitant à contacter TN Marine directement (voir src/app/api/chat/route.ts).
ANTHROPIC_API_KEY=
